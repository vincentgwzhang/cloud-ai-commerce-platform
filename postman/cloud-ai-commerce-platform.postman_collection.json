              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"{{inventoryProductCode}}\",\n  \"quantity\": 1,\n  \"requestId\": \"{{inventoryRequestId}}\"\n}"
            },
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/release",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "release"]
            },
            "description": "Moves quantity from reserved back to available. Use after **Reserve Stock**."
          },
          "response": []
        },
        {
