            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/demo/concurrent-reserve",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "demo", "concurrent-reserve"]
            },
            "description": "Public stress demo (no JWT). RTX5090 seed stock = 20; expect successes ≤ 20."
          },
          "response": []
