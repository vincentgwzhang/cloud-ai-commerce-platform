    {
      "name": "Inventory Service",
      "description": "Port **8082**. Requires JWT except **Health** and **Concurrent Reserve Demo**.\n\nRun **Auth Service → Login** first. Seed SKUs: `IPHONE17` (100), `RTX5090` (20), `PS6` (50).\n\nUse a unique `requestId` per mutation; **Reserve (idempotent retry)** reuses `{{inventoryRequestId}}`.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/health",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "health"]
            },
            "description": "Public. Expected: `{ \"success\": true, \"data\": { \"status\": \"UP\" } }`"
          },
          "response": []
        },
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/{{inventoryProductCode}}",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "{{inventoryProductCode}}"]
            },
            "description": "Requires JWT. Set `inventoryProductCode` (default `IPHONE17`)."
          },
          "response": []
        },
        {
          "name": "Reserve Stock",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('inventoryRequestId', requestId);",
                  "if (pm.environment) {",
                  "    pm.environment.set('inventoryRequestId', requestId);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('reserve succeeded', function () {",
                  "        pm.expect(pm.response.json().success).to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"{{inventoryProductCode}}\",\n  \"quantity\": 1,\n  \"requestId\": \"{{inventoryRequestId}}\"\n}"
            },
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/reserve",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "reserve"]
            },
            "description": "Reserves stock (available → reserved). Saves `inventoryRequestId` for idempotency demo."
          },
          "response": []
        },
        {
          "name": "Reserve (idempotent retry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"{{inventoryProductCode}}\",\n  \"quantity\": 1,\n  \"requestId\": \"{{inventoryRequestId}}\"\n}"
            },
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/reserve",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "reserve"]
            },
            "description": "Run after **Reserve Stock** with the same `inventoryRequestId`. Should return the same result without double-reserving."
          },
          "response": []
        },
        {
          "name": "Release Stock",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestId = pm.variables.replaceIn('{{$guid}}');",
