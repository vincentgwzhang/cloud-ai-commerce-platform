              "raw": "{\n  \"productCode\": \"{{inventoryProductCode}}\",\n  \"quantity\": 1,\n  \"requestId\": \"{{inventoryRequestId}}\"\n}"
            },
            "url": {
              "raw": "{{inventoryServiceBaseUrl}}/api/inventory/deduct",
              "host": ["{{inventoryServiceBaseUrl}}"],
              "path": ["api", "inventory", "deduct"]
            },
            "description": "Consumes reserved stock (e.g. after payment). Reserve first, then deduct."
          },
          "response": []
